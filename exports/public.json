          "attribution_required": false
        },
        "L2": {
          "shot": "02-01",
          "en": "The king heard it and lost himself.",
          "hi": "राजा ने सुना और होश खो बैठा।",
          "te": "రాజు విని స్పృహ కోల్పోయాడు.",
          "speaker": null,
          "attribution_required": false
        },
        "L3": {
          "shot": "03-05",
          "en": "He said he had waited a long time for this son.",
          "hi": "उसने कहा कि इस बेटे के लिए बहुत इंतज़ार किया।",
          "te": "ఈ కొడుకు కోసం చాలా కాలం ఎదురుచూశానని అతను అన్నాడు.",
          "speaker": "DASARATHA",
          "attribution_required": true
        },
        "L4": {
