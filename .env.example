# PBL Ramayana Studio - provider configuration.
# One interface per concern in lib/providers.js. Swap here, change no code.

TEXT_PROVIDER=anthropic
IMAGE_PROVIDER=fal
MOTION_PROVIDER=fal
VOICE_PROVIDER=elevenlabs
MUSIC_PROVIDER=none

# Two ways to authenticate.
#
# 1. SAFER - an environment API credential. The key is stored on the cloud
#    environment and the agent proxy attaches it after the request leaves this
#    container, so it never exists here at all. Leave the key blank and set the
#    matching *_AUTH_VIA_PROXY flag to 1.
# 2. A key in this file. Simple, but the key is then in the container.
#
# Leave everything blank and preflight says "no credential" rather than guessing.
ANTHROPIC_API_KEY=
FAL_KEY=
ELEVENLABS_API_KEY=

FAL_AUTH_VIA_PROXY=0
ELEVEN_AUTH_VIA_PROXY=0

# Voice ids, per language. ElevenLabs.
ELEVEN_VOICE_EN=
ELEVEN_VOICE_HI=
ELEVEN_VOICE_TE=

# Spend ceiling in USD. A run that would exceed this refuses before it spends.
SPEND_CEILING_USD=60

# Set to 1 to allow real billable calls. Absent or 0 means estimate-only.
ALLOW_SPEND=0

PORT=4173
