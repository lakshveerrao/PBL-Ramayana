{
  "name": "pbl-ramayana-studio",
  "version": "0.1.0",
  "private": true,
  "description": "PBL Ramayana Studio - the Ramayana as ~900 micro-episodes of ~44s, in English, Hindi and Telugu.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate": "NODE_USE_ENV_PROXY=1 node tools/validate.js",
    "regress": "NODE_USE_ENV_PROXY=1 node tools/regress.js",
    "dryrun": "NODE_USE_ENV_PROXY=1 node tools/dryrun.js",
    "preflight": "NODE_USE_ENV_PROXY=1 node tools/preflight.js",
    "start": "NODE_USE_ENV_PROXY=1 node server.js",
    "check": "NODE_USE_ENV_PROXY=1 node tools/validate.js && NODE_USE_ENV_PROXY=1 node tools/regress.js && NODE_USE_ENV_PROXY=1 node tools/typecheck.js && NODE_USE_ENV_PROXY=1 node tools/gradecheck.js",
    "typecheck": "NODE_USE_ENV_PROXY=1 node tools/typecheck.js",
    "gradecheck": "NODE_USE_ENV_PROXY=1 node tools/gradecheck.js",
    "cutcheck": "NODE_USE_ENV_PROXY=1 node tools/cutcheck.js",
    "assemble": "NODE_USE_ENV_PROXY=1 node tools/assemble.js",
    "audition": "NODE_USE_ENV_PROXY=1 node tools/audition.js",
    "motiontest": "NODE_USE_ENV_PROXY=1 node tools/motiontest.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "playwright": "^1.63.0"
  }
}
